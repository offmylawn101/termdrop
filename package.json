{
  "name": "termdrop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "github:offmylawn101/termdrop",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/verify-static.mjs --dist",
    "check:static": "node scripts/verify-static.mjs",
    "dev": "npm run build && wrangler dev",
    "dev:ui": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run check && wrangler deploy",
    "check": "npm run typecheck && npm run lint && npm run check:static && npm test && npm run build",
    "e2e:sender": "node scripts/manual-e2e.mjs",
    "e2e:browser-background": "node scripts/browser-background-e2e.mjs",
    "ad:admin": "node scripts/ad-admin.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.0",
    "@types/node": "^26.3.0",
    "@eslint/js": "^10.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
